AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# Provider defaults to ollama; set to bedrock to use BEDROCK_MODEL_ID.
SIMULATOR_PROVIDER=
# Defaults to llama3.1:8b (llama3.2:3b is the smaller fallback).
SIMULATOR_OLLAMA_MODEL=
# Defaults to http://localhost:11434 for non-Docker development. In Docker use
# http://host.docker.internal:11434 when Ollama runs on the host Mac.
OLLAMA_HOST=
DYNAMODB_TABLE=homie-dev
# Optional: DynamoDB endpoint for local development (e.g. http://localhost:8001 or http://dynamodb-local:8000)
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
CORS_ORIGINS=["http://localhost:3000"]
COGNITO_USER_POOL_ID=us-east-1_QiV9mNe4W
COGNITO_DOMAIN=
COGNITO_CLIENT_IDS=5nc9ipnu9f7s2de5tto3daag4b
PUBLIC_BASE_URL=http://localhost:8000
MCP_TOOLS_SCOPE=homie/mcp:tools
MCP_SERVICE_SCOPE=homie/mcp:service
MEDIA_BUCKET=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
